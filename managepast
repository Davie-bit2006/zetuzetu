                <button class="close-modal" onclick="closeModal('portfolioModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="portfolio-modal-content">
                    <div>
                        <h4 id="portfolioFreelancerName"></h4>
                        <div id="portfolioProfession" style="color: var(--primary-color); font-weight: 600; margin-bottom: 15px;"></div>
                        <div class="portfolio-description" id="portfolioDescription"></div>
                        
                        <div style="margin-top: 20px;">
                            <a href="#" id="portfolioWhatsappLink" class="btn btn-primary btn-full" target="_blank">
                                <i class="fab fa-whatsapp"></i> Contact Me on WhatsApp
                            </a>
                        </div>
                    </div>
                    
                    <div>
                        <h4 style="margin-bottom: 15px;">Portfolio Images</h4>
                        <div class="portfolio-gallery" id="portfolioGallery">
                            <!-- Portfolio images loaded by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
    // FIXED: Open Product Modal using data attributes
    function handleProductDetailsClick(e) {
        const button = e.target.closest('.view-product-details-btn');
        if (!button) return;
        
        const product = {
            name: button.dataset.name,
            price: parseFloat(button.dataset.price),
            description: button.dataset.description,
            seller_name: button.dataset.seller,
            whatsapp_number: button.dataset.whatsapp,
            price_type: button.dataset.priceType
        };
        
        const images = JSON.parse(button.dataset.images || '[]');
        openProductModal(product, images);
    }
    
    function openProductModal(product, images) {
        let imagesHtml = '';
        let thumbnailsHtml = '';
        
        if (images && images.length > 0) {
            images.forEach((image, index) => {
                imagesHtml += `
                    <img src="${image}" class="main-image" id="mainImage-${index}" 
                         style="display: ${index === 0 ? 'block' : 'none'};">
                `;
                thumbnailsHtml += `
                    <img src="${image}" class="thumbnail ${index === 0 ? 'active' : ''}" 
                         onclick="changeMainImage(${index})">
                `;
            });
        } else {
            imagesHtml = '<img src="https://via.placeholder.com/400x300?text=No+Image" class="main-image">';
        }
        
        // Create WhatsApp contact link
        const message = `Hi, I'm interested in your product: ${encodeURIComponent(product.name)} - KSh ${product.price.toLocaleString('en-KE', {minimumFractionDigits: 2})}`;
        const whatsappLink = `https://wa.me/254750755500?text=${message}`;
        
        const modalBody = document.getElementById('productModalBody');
        modalBody.innerHTML = `
            <div class="product-details">
                <div class="product-images">
                    <div id="mainImageContainer">
                        ${imagesHtml}
                    </div>
                    ${images && images.length > 1 ? `
                    <div class="thumbnail-images">
                        ${thumbnailsHtml}
                    </div>
                    ` : ''}
                </div>
                
                <div class="product-info-details">
                    <h2>${product.name}</h2>
                    <div class="product-price-large">KSh ${product.price.toLocaleString('en-KE', {minimumFractionDigits: 2})}</div>
                    
                    ${product.price_type ? `
                    <div style="margin-bottom: 15px;">
                        <span style="background-color: #f0f0f0; padding: 5px 15px; border-radius: 20px; font-size: 14px;">
                            ${product.price_type.replace('_', ' ')}
                        </span>
                    </div>
                    ` : ''}
                    
                    <div class="product-description-full">
                        ${product.description ? product.description.replace(/\n/g, '<br>') : 'No description available'}
                    </div>
                    
                    <div class="seller-info">
                        <h4>Seller Information</h4>
                        <p><strong>Name:</strong> ${product.seller_name || 'Not specified'}</p>
                        <p><strong>Contact:</strong> ${product.whatsapp_number || 'Not specified'}</p>
                    </div>
                    
                    <div class="contact-seller">
                        <a href="${whatsappLink}" 
                           target="_blank" class="btn btn-primary">
                            <i class="fab fa-whatsapp" style="font-size: 20px;"></i>
                            <span>Contact on WhatsApp</span>
                        </a>
                        
                        <a href="tel:${product.whatsapp_number || '254750755500'}" 
                           class="btn btn-secondary">
                            <i class="fas fa-phone" style="font-size: 20px;"></i>
                            <span>Call Seller</span>
                        </a>
                    </div>
                </div>
            </div>
        `;
        
        document.getElementById('productModal').style.display = 'flex';
    }
    
    // Open Services Modal
    function openServicesModal(e) {
        e.preventDefault();
        document.getElementById('servicesModal').style.display = 'flex';
    }
    
    // Search Services
    function searchServices() {
        const searchInput = document.getElementById('servicesSearchInput');
        const searchTerm = searchInput.value.toLowerCase();
        const serviceCards = document.querySelectorAll('.service-card');
        
        serviceCards.forEach(card => {
            const name = card.dataset.name.toLowerCase();
            const profession = card.dataset.profession.toLowerCase();
            const description = card.dataset.description.toLowerCase();
            
            if (name.includes(searchTerm) || profession.includes(searchTerm) || description.includes(searchTerm)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
    
    // FIXED: Open Portfolio Modal - Now uses event delegation
    function handlePortfolioButtonClick(e) {
        const button = e.target.closest('.view-portfolio-btn');
        if (!button) return;
        
        const freelancerName = button.dataset.freelancer;
        const profession = button.dataset.profession;
        const description = button.dataset.description;
        const whatsappNumber = button.dataset.whatsapp;
        const portfolioImages = JSON.parse(button.dataset.portfolio || '[]');
        
        openPortfolioModal(freelancerName, profession, portfolioImages, description, whatsappNumber);
    }
    
    // Open Portfolio Modal (Updated to include description)
    function openPortfolioModal(freelancerName, profession, images, description, whatsappNumber) {
        document.getElementById('portfolioTitle').textContent = `${freelancerName}'s Portfolio`;
        document.getElementById('portfolioFreelancerName').textContent = freelancerName;
        document.getElementById('portfolioProfession').textContent = profession;
        document.getElementById('portfolioDescription').textContent = description;
        
        // Set WhatsApp link
        const whatsappLink = document.getElementById('portfolioWhatsappLink');
        const message = `Hi ${encodeURIComponent(freelancerName)}, I'm interested in your ${encodeURIComponent(profession)} services. I saw your portfolio on Zetumarket.`;
        whatsappLink.href = `https://wa.me/${whatsappNumber}?text=${message}`;
        
        const gallery = document.getElementById('portfolioGallery');
        gallery.innerHTML = '';
        
        if (images && images.length > 0) {
            images.forEach(image => {
                gallery.innerHTML += `
                    <img src="${image}" class="portfolio-image" onclick="openImageModal('${image.replace(/'/g, "\\'")}')">
                `;
            });
        } else {
            gallery.innerHTML = '<div class="empty-state"><i class="fas fa-images"></i><p>No portfolio images available</p></div>';
        }
        
        document.getElementById('portfolioModal').style.display = 'flex';
    }
    
    // Open Contact Modal
    function openContactModal(e) {
        e.preventDefault();
        document.getElementById('contactModal').style.display = 'flex';
    }
    
    // Open Image Modal (for larger view)
    function openImageModal(imageSrc) {
        const modal = document.createElement('div');
        modal.className = 'modal-overlay';
        modal.style.display = 'flex';
        modal.style.zIndex = '1004';
        modal.innerHTML = `
            <div style="max-width: 90vw; max-height: 90vh; background: white; border-radius: 10px; padding: 10px;">
                <img src="${imageSrc}" style="width: 100%; height: 100%; object-fit: contain; border-radius: 5px;">
            </div>
        `;
        modal.onclick = function() {
            document.body.removeChild(modal);
        };
        document.body.appendChild(modal);
    }
    
    // Change main image when thumbnail is clicked
    function changeMainImage(index) {
        document.querySelectorAll('.main-image').forEach(img => {
            img.style.display = 'none';
        });
        
        document.getElementById('mainImage-' + index).style.display = 'block';
        
        document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
            thumb.classList.toggle('active', i === index);
        });
    }
    
    // Close modal
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }
    
    // Close modals when clicking outside
    window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.style.display = 'none';
        }
    }
    
    // Scroll to Top functionality
    const scrollToTopBtn = document.getElementById('scrollToTop');
    
    window.addEventListener('scroll', function() {
        if (window.pageYOffset > 300) {
            scrollToTopBtn.style.display = 'flex';
        } else {
            scrollToTopBtn.style.display = 'none';
        }
    });
    
    scrollToTopBtn.addEventListener('click', function() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
    
    // Services search when pressing Enter
    const servicesSearchInput = document.getElementById('servicesSearchInput');
    if (servicesSearchInput) {
        servicesSearchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                searchServices();
            }
        });
    }
    
    // Fix for mobile layout and iOS issues
    document.addEventListener('DOMContentLoaded', function() {
        // FIXED: Event delegation for product details buttons
        const productsGrid = document.querySelector('.products-grid');
        if (productsGrid) {
            productsGrid.addEventListener('click', handleProductDetailsClick);
        }
        
        // FIXED: Event delegation for portfolio buttons
        const servicesGrid = document.getElementById('servicesGrid');
        if (servicesGrid) {
            servicesGrid.addEventListener('click', handlePortfolioButtonClick);
        }
        
        // Calculate and set body padding for mobile
        function adjustBodyPadding() {
            if (window.innerWidth <= 768) {
                const searchSection = document.querySelector('.search-section');
                const categoriesNav = document.querySelector('.categories-nav');
                const mobileFooter = document.querySelector('.mobile-footer-nav');
                
                if (searchSection && categoriesNav && mobileFooter) {
                    const searchHeight = searchSection.offsetHeight;
                    const categoriesHeight = categoriesNav.offsetHeight;
                    const footerHeight = mobileFooter.offsetHeight;
                    
                    document.body.style.paddingTop = (searchHeight + categoriesHeight) + 'px';
                    document.body.style.paddingBottom = footerHeight + 'px';
                }
            } else {
                document.body.style.paddingTop = '0';
                document.body.style.paddingBottom = '0';
            }
        }
        
        // Adjust on load and resize
        adjustBodyPadding();
        window.addEventListener('resize', adjustBodyPadding);
        window.addEventListener('orientationchange', function() {
            setTimeout(adjustBodyPadding, 100);
        });
        
        // Fix for iOS Safari 100vh issue
        function setVH() {
            let vh = window.innerHeight * 0.01;
            document.documentElement.style.setProperty('--vh', `${vh}px`);
        }
        
        setVH();
        window.addEventListener('resize', setVH);
        window.addEventListener('orientationchange', setVH);
        
        // FIXED: Subcategories dropdown for mobile
        const categoryItems = document.querySelectorAll('.category-item');
        
        categoryItems.forEach(item => {
            const link = item.querySelector('.category-link');
            const dropdown = item.querySelector('.subcategories-dropdown');
            
            if (dropdown) {
                // For mobile touch - FIXED IMPLEMENTATION
                link.addEventListener('click', function(e) {
                    if (window.innerWidth <= 768) {
                        // If there's a subcategory dropdown, prevent default and show it
                        if (dropdown) {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            // Close other open dropdowns
                            document.querySelectorAll('.subcategories-dropdown').forEach(d => {
                                if (d !== dropdown) {
                                    d.style.display = 'none';
                                    d.previousElementSibling.classList.remove('dropdown-open');
                                }
                            });
                            
                            // Toggle this dropdown
                            if (dropdown.style.display === 'flex') {
                                dropdown.style.display = 'none';
                                link.classList.remove('dropdown-open');
                            } else {
                                // Position dropdown correctly
                                const rect = link.getBoundingClientRect();
                                dropdown.style.display = 'flex';
                                dropdown.style.top = (rect.bottom + window.scrollY + 5) + 'px';
                                dropdown.style.left = '50%';
                                dropdown.style.transform = 'translateX(-50%)';
                                dropdown.style.width = '90%';
                                dropdown.style.position = 'fixed';
                                dropdown.style.zIndex = '1005';
                                link.classList.add('dropdown-open');
                            }
                        } else {
                            // If no dropdown, follow the link
                            window.location.href = link.href;
                        }
                    }
                });
                
                // Keep dropdown open when clicking inside
                dropdown.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            }
        });
        
        // Close dropdowns when clicking outside on mobile
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                if (!e.target.closest('.category-item') || 
                    !e.target.closest('.subcategories-dropdown')) {
                    document.querySelectorAll('.subcategories-dropdown').forEach(d => {
                        d.style.display = 'none';
                        const link = d.previousElementSibling;
                        if (link) link.classList.remove('dropdown-open');
                    });
                }
            }
        });
        
        // Close dropdowns when scrolling on mobile
        window.addEventListener('scroll', function() {
            if (window.innerWidth <= 768) {
                document.querySelectorAll('.subcategories-dropdown').forEach(d => {
                    d.style.display = 'none';
                    const link = d.previousElementSibling;
                    if (link) link.classList.remove('dropdown-open');
                });
            }
        });
        
        // Search form submit when pressing Enter
        const searchInput = document.querySelector('.search-input');
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    document.getElementById('searchForm').submit();
                }
            });
        }
        
        // Fix for mobile viewport height
        function fixMobileHeight() {
            if ('visualViewport' in window) {
                const visualViewport = window.visualViewport;
                document.documentElement.style.height = visualViewport.height + 'px';
            }
        }
        
        if ('visualViewport' in window) {
            window.visualViewport.addEventListener('resize', fixMobileHeight);
            window.visualViewport.addEventListener('scroll', fixMobileHeight);
        }
        
        // Initialize
        fixMobileHeight();
    });
    </script>
</body>
</html>